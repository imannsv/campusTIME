{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:demo",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/display/:path*", "destination": "/index.html" },
    { "source": "/overview/:path*", "destination": "/index.html" }
  ]
}
