# Backend-/Worker-Umgebung, niemals Browservariablen.
# Echte Werte sicher beim Backend-Host hinterlegen. Django lädt diese Datei nicht automatisch.
DEBUG=0
SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_HOST=db.knwieisajkaiphosfssa.supabase.co
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-database-password
POSTGRES_SSLMODE=require
POSTGRES_SCHEMA=campustime
REDIS_URL=redis://your-private-redis-host:6379/0
LOCAL_WORKER=0
ALLOWED_HOSTS=api.your-domain.example
CSRF_TRUSTED_ORIGINS=https://your-frontend-domain.example
TRUST_PROXY=1
SECURE_SSL_REDIRECT=1
