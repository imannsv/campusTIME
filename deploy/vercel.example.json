{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.your-domain.example/api/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://api.your-domain.example/admin/:path*"
    },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
